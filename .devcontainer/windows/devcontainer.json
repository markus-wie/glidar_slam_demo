{
  "name": "windows",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": {
      "ROS_DISTRO": "lyrical",
      "USERNAME": "ros"
    }
  },
  "containerUser": "ros",
  "remoteUser": "ros",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "all",
    "CCACHE_CONFIGPATH": "${containerWorkspaceFolder}/ccache.conf",
    "WORKSPACE_ROOT": "${containerWorkspaceFolder}",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
    "QT_X11_NO_MITSHM": "0",
    "GALLIUM_DRIVER": "d3d12",
    "MESA_D3D12_DEFAULT_ADAPTER_NAME": "NVIDIA"
  },
  "remoteEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dir",
    "LD_LIBRARY_PATH": "${containerEnv:LD_LIBRARY_PATH}:/usr/lib/wsl/lib",
    "DEBUGINFOD_URLS": ""
  },
  "privileged": true,
  "runArgs": [
    "--network=host",
    "--shm-size=2gb",
    "--ipc=host",
    "--device=/dev/dxg",
    "--volume=/mnt/wslg/.X11-unix:/tmp/.X11-unix",
    "--volume=/mnt/wslg:/mnt/wslg:ro",
    "--volume=/usr/lib/wsl:/usr/lib/wsl:ro"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "ms-python.black-formatter",
        "ranch-hand-robotics.rde-ros-2",
        "ms-azuretools.vscode-docker",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "actboy168.tasks",
        "rioj7.command-variable"
      ]
    }
  }
}