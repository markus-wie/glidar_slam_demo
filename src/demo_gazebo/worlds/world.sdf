<?xml version="1.0"?>
<sdf version="1.11" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="car_type" default="car_damped"/>
  <xacro:arg name="course_type" default="course_short_complex_corridor"/>
  <xacro:property name="car_type" value="$(arg car_type)"/>
  <xacro:property name="course_type" value="$(arg course_type)"/>
  <world name="runway">
    <!-- Physics settings -->
    <!-- Even if you were to select "ode", dart is used. Also, the <dart> AND the <ode> tags both have an influence. -->
    <physics name="simulation" type="dart">
      <xacro:if value="${car_type == 'car_damped'}">
        <max_step_size>0.001</max_step_size>
        <real_time_update_rate>1000</real_time_update_rate>
      </xacro:if>
      <xacro:unless value="${car_type == 'car_damped'}">
        <max_step_size>0.01</max_step_size>
        <real_time_update_rate>100</real_time_update_rate>
      </xacro:unless>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <solver>
          <xacro:if value="${car_type == 'car_damped'}">
            <solver_type>pgs</solver_type>
          </xacro:if>
          <xacro:unless value="${car_type == 'car_damped'}">
            <solver_type>dantzig</solver_type>
          </xacro:unless>
        </solver>
      </dart>
      <ode>
        <solver>
          <type>world</type> <!-- world or quick -->
        </solver>
      </ode>
    </physics>

    <!-- ########################################################################## -->
    <!-- system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ########################################################################## -->
    <!-- GUI specific plugins. These plugins are native to this world file. A gui config file might override these. -->
    <gui fullscreen='false'>
      <plugin name='3D View' filename='MinimalScene'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>1.8 -7.2000000000000002 2.2999999999999998 3.082421559590729e-17 0.44999999999999996 2.3999999999999999</camera_pose>
      </plugin>
      <plugin name='Entity context menu' filename='EntityContextMenuPlugin'>
        <gz-gui>
          <property key='state' type='string'>floating</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='showTitleBar' type='bool'>false</property>
          <property key='enabled' type='bool'>true</property>
          <property key='visible' type='bool'>true</property>
        </gz-gui>
      </plugin>
      <plugin name='Scene Manager' filename='GzSceneManager'>
        <gz-gui>
          <property key='resizable' type='bool'>false</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='state' type='string'>floating</property>
          <property key='showTitleBar' type='bool'>false</property>
        </gz-gui>
      </plugin>
      <plugin name='Interactive view control' filename='InteractiveViewControl'>
        <gz-gui>
          <property key='resizable' type='bool'>false</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='state' type='string'>floating</property>
          <property key='showTitleBar' type='bool'>false</property>
        </gz-gui>
      </plugin>
      <plugin name='Camera Tracking' filename='CameraTracking'>
        <gz-gui>
          <property key='resizable' type='bool'>false</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='state' type='string'>floating</property>
          <property key='showTitleBar' type='bool'>false</property>
        </gz-gui>
      </plugin>
      <plugin name='Select Entities' filename='SelectEntities'>
        <gz-gui>
          <anchors target='Select entities'>
            <line own='right' target='right'/>
            <line own='top' target='top'/>
          </anchors>
          <property key='resizable' type='bool'>false</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='state' type='string'>floating</property>
          <property key='showTitleBar' type='bool'>false</property>
          <property key='enabled' type='bool'>true</property>
          <property key='visible' type='bool'>true</property>
        </gz-gui>
      </plugin>
      <plugin name='Visualization Capabilities' filename='VisualizationCapabilities'>
        <gz-gui>
          <property key='resizable' type='bool'>false</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='state' type='string'>floating</property>
          <property key='showTitleBar' type='bool'>false</property>
        </gz-gui>
      </plugin>
      <plugin name='Spawn Entities' filename='Spawn'>
        <gz-gui>
          <anchors target='Select entities'>
            <line own='right' target='right'/>
            <line own='top' target='top'/>
          </anchors>
          <property key='resizable' type='bool'>false</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='state' type='string'>floating</property>
          <property key='showTitleBar' type='bool'>false</property>
        </gz-gui>
      </plugin>
      <plugin name='World control' filename='WorldControl'>
        <gz-gui>
          <title>World control</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>72</property>
          <property type='double' key='width'>140</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='left' target='left'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin name='Transform control' filename='TransformControl'>
        <gz-gui>
          <title>Transformation</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>50</property>
          <property type='double' key='width'>280</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <property key='enabled' type='bool'>true</property>
          <property key='visible' type='bool'>true</property>
          <property key='cardBackground' type='string'>#ffffff</property>
          <anchors target='3D View'>
            <line own='left' target='left'/>
            <line own='top' target='top'/>
          </anchors>
        </gz-gui>
      </plugin>
      <plugin name='World stats' filename='WorldStats'>
        <gz-gui>
          <title>World stats</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>110</property>
          <property type='double' key='width'>290</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <property key='enabled' type='bool'>true</property>
          <property key='visible' type='bool'>true</property>
          <property key='cardBackground' type='string'>#ffffff</property>
          <anchors target='3D View'>
            <line own='right' target='right'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
        <topic>/world/runway/stats</topic>
      </plugin>
      <plugin name='Marker manager' filename='MarkerManager'>
        <gz-gui>
          <title>World stats</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property key='enabled' type='bool'>true</property>
          <property key='visible' type='bool'>false</property>
          <property type='string' key='state'>floating</property>
        </gz-gui>
      </plugin>
      <plugin name='Component Inspector' filename='ComponentInspector'/>
      <plugin name='Entity tree' filename='EntityTree'/>
      <plugin name='plot' filename='Plot3D'>
        <entity_name>world</entity_name>
        <color>0 1 0</color>
        <offset>0 0 0</offset>
        <minimum_distance>0.04</minimum_distance>
        <maximum_points>50000</maximum_points>
      </plugin>
      <plugin name='Shapes' filename='Shapes'/>
    </gui>

    <!-- Sun -->
    <light name='sun' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <scene>
      <grid>false</grid>
      <shadows>false</shadows>
      <sky>
        <clouds>
        </clouds>
      </sky>
    </scene>

    <!-- Ground Plane -->
    <include>
      <static>1</static>
      <uri>model://ground_plane</uri>
      <name>ground_plane</name>
    </include>


    <include>
      <static>1</static>
      <uri>model://${course_type}</uri>
      <xacro:if value="${course_type == 'course_small'}">
        <pose>-1.0 -2.5 0 0 0 0</pose>
      </xacro:if>
    </include>

    <include>
      <uri>model://${car_type}</uri>
      <name>car</name>
      <pose>-1.0 -6.5 0.2 0 0 -3.14</pose>
    </include>

  </world>
</sdf>
