<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.12">
    <model name="ground_plane">
        <link name="link">
            <collision name="collision">
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>100 100</size>
                    </plane>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>100</mu>
                            <mu2>100</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/ground_plane.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0</diffuse>
                    <specular>1.0 1.0 1.0</specular>
                    <pbr>
                        <metal>
                            <albedo_map>materials/textures/Cobbles_Albedo.png</albedo_map>
                            <normal_map>materials/textures/Cobbles_NormalMap.png</normal_map>
                            <ambient_occlusion_map>materials/textures/Cobbles_AmbientOcclusionMap.png</ambient_occlusion_map>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </link>
    </model>
</sdf>
