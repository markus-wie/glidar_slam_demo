              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
                <dynamic_bias_stddev>0.002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
