    <!-- Sensors -->
    <link name="camera">
      <pose>0.1 0 0.225 0 0.148353 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <sensor name="oak_d_pro_w_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>2.216568</horizontal_fov>
          <image>
            <width>1280</width>
            <height>800</height>
          </image>

          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>

          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>

            <!-- As per specification, the depth error is <2% for distances below 3.5m. It is assumed that any depth measurements taken are below 3.5m -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.03</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>camera</topic>
        <frame_id>camera_optical</frame_id>
      </sensor>
    </link>

    <joint name="base_link_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera</child>
    </joint>

    <link name="camera_optical">
      <pose relative_to="camera">0 0 0 -1.5708 0 -1.5708</pose>
    </link>

    <joint name="camera_optical_joint" type="fixed">
      <parent>camera</parent>
      <child>camera_optical</child>
    </joint>

    <link name="imu">
      <pose>0.1 0 0.2 0 0 0</pose>
