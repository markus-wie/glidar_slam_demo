    <!-- *********************** Lidar ************************  -->
    <link name="lidar">
      <!-- The model is tilted forward by about 1 degree because the mounting on the baseplate is tilted for the front wheels. -->
      <!-- <pose>0.225 0 0.12 0 -0.01745329 0</pose> -->
      <pose>0.225 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </visual>
      <sensor name='lidar' type='gpu_lidar'>
        <always_on>1</always_on>
        <frame_id>lidar</frame_id>
        <topic>lidar</topic>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <!-- 360 degrees / 0.5 degrees = 720 samples -->
              <samples>720</samples>
              <resolution>1</resolution>
              <!-- 360 degrees in radians: -pi to +pi -->
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>16.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

