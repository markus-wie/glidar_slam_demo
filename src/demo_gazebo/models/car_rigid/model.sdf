                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
                <dynamic_bias_stddev>0.002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
                <dynamic_bias_stddev>0.002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
                <dynamic_bias_stddev>0.002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="base_link_imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu</child>
    </joint>

    <link name="camera">
      <pose>0.317 0 0.147 0 0.148353 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <sensor name="oak_d_pro_w_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>2.216568</horizontal_fov>
          <image>
            <width>1280</width>
            <height>800</height>
          </image>

          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>

          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>

            <!-- As per specification, the depth error is <2% for distances below 3.5m. It is assumed that any depth measurements taken are below 3.5m -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.03</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>camera</topic>
        <frame_id>camera_optical</frame_id>
      </sensor>
    </link>
    <joint name="base_link_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera</child>
    </joint>

    <!-- Optical Frame of the camera with z-forward, x-left, y-up -->
    <link name="camera_optical">
      <pose relative_to="camera">0 0 0 -1.5708 0 -1.5708</pose>
    </link>

    <joint name="camera_optical_joint" type="fixed">
      <parent>camera</parent>
      <child>camera_optical</child>
    </joint>

    <!-- *********************** Sonar ************************  -->
    <link name="sonar_mid_b">
      <pose>-0.05 0 0.04 0 0 3.1415926535</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <visual name="sonar_mid_b_visual">
        <geometry>
          <box>
            <size>0.02 0.005 0.03</size>
          </box>
        </geometry>
      </visual>
      <sensor name='sonar_mid_b_sensor' type='gpu_lidar'>
        <always_on>1</always_on>
        <frame_id>sonar_mid_b</frame_id>
        <topic>/sonar_back_mid</topic>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>10</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.01</min>
            <max>4</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <link name="sonar_lb">
      <pose>-0.05 0.1 0.04 0 0 3.1415926535</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <visual name="sonar_lb_visual">
        <geometry>
          <box>
            <size>0.02 0.005 0.03</size>
          </box>
        </geometry>
      </visual>
      <sensor name='sonar_lb_sensor' type='gpu_lidar'>
        <always_on>1</always_on>
        <frame_id>sonar_lb</frame_id>
        <topic>/sonar_back_left</topic>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>10</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.01</min>
            <max>4</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <link name="sonar_rb">
      <pose>-0.05 -0.1 0.04 0 0 3.1415926535</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <visual name="sonar_rb_visual">
        <geometry>
          <box>
            <size>0.02 0.005 0.03</size>
          </box>
        </geometry>
      </visual>
      <sensor name='sonar_rb_sensor' type='gpu_lidar'>
        <always_on>1</always_on>
        <frame_id>sonar_rb</frame_id>
        <topic>/sonar_back_right</topic>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>10</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.01</min>
            <max>4</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <link name="sonar_l">
      <pose>0.3 0.14 0.04 0 0 1.5707963267948966</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <visual name="sonar_l_visual">
        <geometry>
          <box>
            <size>0.02 0.005 0.03</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
      <sensor name='sonar_l_sensor' type='gpu_lidar'>
        <pose >0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <frame_id>sonar_l</frame_id>
        <topic>/sonar_left</topic>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>10</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.01</min>
            <max>4</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <link name="sonar_r">
      <pose>0.3 -0.14 0.04 0 0 -1.5707963267948966</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <visual name="sonar_r_visual">
        <geometry>
          <box>
            <size>0.02 0.005 0.03</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
      <sensor name='sonar_r_sensor' type='gpu_lidar'>
        <pose >0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <frame_id>sonar_r</frame_id>
        <topic>/sonar_right</topic>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>10</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.01</min>
            <max>4</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <!-- *********************** Lidar ************************  -->
    <link name="lidar">
      <pose>0.225 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </visual>
      <sensor name='lidar' type='gpu_lidar'>
        <!-- Rotate the lidar 180 degree roll, to produce CW data instead of CCW -->
        <!-- Rotate 180 degree yaw to make it look "forward" -->
        <always_on>1</always_on>
        <frame_id>lidar</frame_id>
        <topic>lidar</topic>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <!-- 360 degrees / 0.5 degrees = 720 samples -->
              <samples>720</samples>
              <resolution>1</resolution>
              <!-- 360 degrees in radians: -pi to +pi -->
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.03</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <joint name="base_link_sonar_l_joint" type="fixed">
      <parent>base_link</parent>
      <child>sonar_l</child>
    </joint>
    <joint name="base_link_sonar_r_joint" type="fixed">
      <parent>base_link</parent>
      <child>sonar_r</child>
    </joint>
    <joint name="base_link_sonar_mid_b" type="fixed">
      <parent>base_link</parent>
      <child>sonar_mid_b</child>
    </joint>
    <joint name="base_link_sonar_rb" type="fixed">
      <parent>base_link</parent>
      <child>sonar_rb</child>
    </joint>
    <joint name="base_link_sonar_lb" type="fixed">
      <parent>base_link</parent>
      <child>sonar_lb</child>
    </joint>
    <joint name="base_link_lidar" type="fixed">
      <parent>base_link</parent>
      <child>lidar</child>
    </joint>

    <link name="base_footprint">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx>
          <iyy>0.0000001</iyy>
          <izz>0.0000001</izz>
          <ixy>0</ixy>
          <iyz>0</iyz>
          <ixz>0</ixz>
        </inertia>
    </inertial>
    </link>
    <joint name="base_footprint_joint" type="fixed">
        <parent>base_link</parent>
        <child>base_footprint</child>
    </joint>
    <!-- ROS2 Control Section -->
    <!-- Used by the GazeboSimROS2ControlPlugin to spawn ros2_control nodes to interact with a ros2 environment -->
    <ros2_control name="GazeboSimSystem" type="system">

      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="wheel_rear_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wheel_rear_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wheel_front_left_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wheel_front_right_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="steering_left_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="steering_right_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

    </ros2_control>

    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="/opt/ros/kilted/lib/libgz_ros2_control-system.so">
      <parameters>/workspaces/glidar_slam_demo/src/demo_bringup/params/controllers-car-damped.yaml</parameters>
    </plugin>

    <plugin name="gz::sim::systems::PosePublisher" filename="gz-sim-pose-publisher-system">
      <!-- Needed to get the exact position of the vehicle in the simulation. Used for evaluation of localization or similar. -->
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <publish_model_pose>true</publish_model_pose>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>

  </model>
</sdf>